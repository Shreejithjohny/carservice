# Copy this file to backend/.env for local development.

# Database Configuration
USE_MYSQL=False
DB_NAME=carservice_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Secret Key & Debug
# Local development only. For production set DEBUG=False and a long random SECRET_KEY, e.g. from
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=django-insecure-smart-doorstep-vehicle-service-key
DEBUG=True

# Address of the React app. Invoice PDF QR codes point to FRONTEND_URL/verify/<code>.
FRONTEND_URL=http://localhost:5173

# Production only: comma-separated hosts and frontend origins allowed to call the API
ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=

# Optional: password the seed script gives the demo accounts (admin@, manager@, driver@, ...),
# so they can also sign in with email + password. Pick your own; leave empty for no passwords.
DEMO_ACCOUNT_PASSWORD=

# Demo login: enables the one-click role logins and the 123456 test codes. Never enable in production.
OTP_BYPASS=True
# Print OTPs to the server console when no SMS/email provider is configured (defaults to DEBUG).
OTP_CONSOLE_FALLBACK=True

# Online invoice payment. "mock" = test gateway, no real money moves. Leave empty to disable online payment.
PAYMENT_GATEWAY=mock

# Google Maps API Key (Optional for Distance Matrix server-side calculations)
GOOGLE_MAPS_API_KEY=

# Twilio Programmable SMS OTP Credentials (Optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Email OTP delivery (free). Set these and sign-in codes for email addresses go out by email.
# Gmail: EMAIL_HOST=smtp.gmail.com, EMAIL_HOST_USER=you@gmail.com, and EMAIL_HOST_PASSWORD = a
#   16-character App Password (Google Account > Security > 2-Step Verification > App passwords),
#   not your normal password. Gmail allows roughly 500 emails a day and sends From your address.
# Brevo, Mailjet, SendGrid etc. give SMTP settings on their free plans too (a few hundred a day).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
# Seconds to wait for the mail server before giving up
EMAIL_TIMEOUT=10

# OTP rate limits (not applied while OTP_BYPASS is on). 0 switches a limit off.
OTP_SEND_LIMIT_PER_IDENTIFIER=5   # codes per email/number per hour
OTP_SEND_LIMIT_PER_IP=10          # code requests per IP address per hour
OTP_SEND_DAILY_LIMIT=400          # codes sent by the whole server per 24 hours (keep under your email/SMS quota)
OTP_VERIFY_LIMIT_PER_IP=30        # code checks per IP address per hour
# Reverse proxies in front of Django (e.g. 1 behind Nginx or a hosting load balancer), so the limits see
# the real client IP. Leave 0 when Django is reached directly: a higher value lets clients fake their IP.
NUM_PROXIES=0

# Optional. Road routes on the Track page come from OSRM. Empty = the free public demo server
# (router.project-osrm.org, fine for a project demo). For real traffic, run your own OSRM and put its URL here.
ROUTING_URL=
