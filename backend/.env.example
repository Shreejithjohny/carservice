# Database Configuration
USE_MYSQL=False
DB_NAME=carservice_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Secret Key & Debug
SECRET_KEY=django-insecure-smart-doorstep-vehicle-service-key
DEBUG=True

# Google Maps API Key (Optional for Distance Matrix server-side calculations)
GOOGLE_MAPS_API_KEY=

# Twilio Programmable SMS OTP Credentials (Optional - Local console fallback enabled by default)
