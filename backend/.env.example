# Copy this file to backend/.env for local development.

# Database Configuration
USE_MYSQL=False
DB_NAME=carservice_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Secret Key & Debug
# Local development only. For production set DEBUG=False and a long random SECRET_KEY, e.g. from
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=django-insecure-smart-doorstep-vehicle-service-key
DEBUG=True

# Address of the React app. Invoice PDF QR codes point to FRONTEND_URL/verify/<code>.
FRONTEND_URL=http://localhost:5173

# Production only: comma-separated hosts and frontend origins allowed to call the API
ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=

# Optional: password the seed script gives the demo accounts (admin@, manager@, driver@, ...),
# so they can also sign in with email + password. Pick your own; leave empty for no passwords.
DEMO_ACCOUNT_PASSWORD=

# Demo login: enables the one-click role logins and the 123456 test codes. Never enable in production.
OTP_BYPASS=True

# Online invoice payment. "mock" = test gateway, no real money moves. "razorpay" = real payments
# (UPI, cards, net banking) through Razorpay. Leave empty to disable online payment.
PAYMENT_GATEWAY=mock
# For PAYMENT_GATEWAY=razorpay. Razorpay Dashboard > Account & Settings > API keys. Start with the
# Test Mode keys (rzp_test_...): no real money moves. Never commit these or share them.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard > Developers > Webhooks > add https://<your API address>/api/payments/razorpay/webhook/
# with events payment.captured and payment.failed, and type any long random secret; put the same secret here.
# It marks an invoice paid even if the customer closes the page right after paying.
RAZORPAY_WEBHOOK_SECRET=

# Browser alerts ("driver assigned", "approve this repair") that arrive even when the site is closed.
# Run once:  python manage.py generate_vapid_keys   and paste its two lines here. Empty = no browser alerts.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address shown to the push services (Google, Mozilla, Apple)
VAPID_CONTACT_EMAIL=

# Google Maps API Key (Optional for Distance Matrix server-side calculations)
GOOGLE_MAPS_API_KEY=

# Optional: "Sign in with Google" (also how "Forgot password?" works). Empty = no Google button.
# Google Cloud Console > APIs & Services > Credentials > Create credentials > OAuth client ID >
# "Web application". Under "Authorized JavaScript origins" add your frontend address(es), e.g.
# http://localhost:5173 and https://your-app.example.com. Copy the Client ID here (it is not secret;
# no client secret is needed). Restart the backend after setting it.
GOOGLE_CLIENT_ID=

# Optional. Road routes on the Track page come from OSRM. Empty = the free public demo server
# (router.project-osrm.org, fine for a project demo). For real traffic, run your own OSRM and put its URL here.
ROUTING_URL=
