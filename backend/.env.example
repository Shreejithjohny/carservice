# Copy this file to backend/.env for local development.

# Database Configuration
USE_MYSQL=False
DB_NAME=carservice_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Secret Key & Debug
# Local development only. For production set DEBUG=False and a long random SECRET_KEY, e.g. from
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=django-insecure-smart-doorstep-vehicle-service-key
DEBUG=True

# Production only: comma-separated hosts and frontend origins allowed to call the API
ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=

# Demo login: enables the one-click role logins and the 123456 test codes. Never enable in production.
OTP_BYPASS=True
# Print OTPs to the server console when no SMS/email provider is configured (defaults to DEBUG).
OTP_CONSOLE_FALLBACK=True

# Online invoice payment. "mock" = test gateway, no real money moves. Leave empty to disable online payment.
PAYMENT_GATEWAY=mock

# Google Maps API Key (Optional for Distance Matrix server-side calculations)
GOOGLE_MAPS_API_KEY=

# Twilio Programmable SMS OTP Credentials (Optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Email OTP delivery (Optional)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
