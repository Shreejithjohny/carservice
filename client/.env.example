# Optional. Without a key the Book page uses the free OpenFreeMap map (no setup needed).
# Google Maps JavaScript API Key
# Obtain your key from Google Cloud Console with Maps JS API, Places API, and Distance Matrix API enabled.
VITE_GOOGLE_MAPS_API_KEY=

# Optional. Map style for the free maps (default: OpenFreeMap Liberty, https://openfreemap.org).
# Other free styles: https://tiles.openfreemap.org/styles/bright or https://tiles.openfreemap.org/styles/positron
VITE_MAP_STYLE_URL=
